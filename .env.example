#   https://urs.earthdata.nasa.gov/approve_app?client_id=e2WVk8Pw6weeLUKZYOxvTQ
# A 403 "EULA Acceptance Failure" means the click was not done — it is not a bad token.
EARTHDATA_TOKEN=

# Copernicus Data Space Ecosystem — Sentinel-1 GRD (src/jaladhar/validation/fetch_s1.py)
CDSE_S3_ENDPOINT=
CDSE_ACCESS_KEY=
